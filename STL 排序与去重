#include <bits/stdc++.h>
using namespace std;
int main()
{
    vector<int> arr;
    string m;
    getline(cin, m);
    stringstream ss(m);
    int num;
        while (ss >> num) 
	{
        arr.push_back(num);
    }
    sort(arr.begin(), arr.end());
    for (int i = 0; i < arr.size(); i++) 
	{
		cout << arr[i] << " ";
    }
    cout << endl;  
    while (ss >> num)
    {
        arr.push_back(num);
    }
    sort(arr.begin(), arr.end());
    
    vector<int>::iterator last = unique(arr.begin(), arr.end());
    arr.erase(last, arr.end());

    for (int i = 0; i < arr.size(); i++)
    {
        cout << arr[i] << " ";
    }
    cout << endl;
    return 0;
}
