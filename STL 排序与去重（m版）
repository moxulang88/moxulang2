#include <iostream>
#include <vector>
#include <algorithm>
#include <set>

using namespace std;

int main()
{
    int n;
    cout << "请输入整数个数 n：";
    cin >> n;

    vector<int> v;
    int num;
    for (int i = 0; i < n; ++i)
    {
        cin >> num;
        v.push_back(num);
    }

    // 排序
    sort(v.begin(), v.end());
    cout << "排序后的结果：";
    for (auto x : v)
    {
        cout << x << " ";
    }
    cout << endl;

    // set 去重
    set<int> s(v.begin(), v.end());
    cout << "去重后的结果：";
    for (auto x : s)
    {
        cout << x << " ";
    }
    cout << endl;

    return 0;
}
