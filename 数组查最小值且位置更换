#include <bits/stdc++.h> //万能头文件 
using namespace std;
int main() 
{
    int p;  // p用于判定数组长度 
    int m[p];  // 创建一个能存p个int的数组
    cin>>p;
    for (int i = 0; i < p; i++) 
	{
		
        cin >> m[i];
    }
    swap(m[min_element(m,m+p)-m], m[p-1]);
    for (int i = 0; i < p; i++) 
	{
		
        cout << m[i] << " ";
    }
    cout << endl;
    return 0;
}
