#include <opencv2/opencv.hpp>
#include <iostream>
using namespace cv;
using namespace std;

int main() {
    Mat src = imread("test.jpg");

    // 从(50,50)位置开始，裁出200x200的区域
    Rect roi(50, 50, 200, 200);
    Mat roiImg = src(roi);
    imwrite("roi_result.jpg", roiImg);

    cout << "ROI cropped image saved." << endl;

    imshow("4-ROI Crop", roiImg);
    waitKey(0);
    destroyAllWindows();
    return 0;
}
