#include <opencv2/opencv.hpp>
#include <iostream>
using namespace cv;
using namespace std;

int main() {
    Mat src = imread("test.jpg");
    if (src.empty()) { cout << "Cannot read image!" << endl; return -1; }

    cout << "Image width: " << src.cols << endl;
    cout << "Image height: " << src.rows << endl;
    cout << "Channels: " << src.channels() << endl;

    imshow("1-Read Image", src);
    waitKey(0);
    destroyAllWindows();
    return 0;
}
