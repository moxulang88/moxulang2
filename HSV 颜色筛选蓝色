#include <opencv2/opencv.hpp>
#include <iostream>
using namespace cv;
using namespace std;

int main() {
    Mat src = imread("test.jpg");
    Mat hsv, mask, result;

    cvtColor(src, hsv, COLOR_BGR2HSV);  // 转到HSV色彩空间

    // 蓝色范围
    Scalar lower(100, 43, 46);
    Scalar upper(124, 255, 255);
    inRange(hsv, lower, upper, mask);   // 生成黑白掩码

    bitwise_and(src, src, result, mask); // 掩码叠加到原图
    imwrite("hsv_mask.jpg", mask);
    imwrite("hsv_result.jpg", result);

    cout << "Blue pixels: " << countNonZero(mask) << endl;

    imshow("6-HSV Mask", mask);
    imshow("6-HSV Result", result);
    waitKey(0);
    destroyAllWindows();
    return 0;
}
